#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // Tell ZMK Studio to use the 5-column layout natively
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_DQT {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp DQT>;
        };

        combo_SQT {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&kp SQT>;
        };

        combo_DEL {
            timeout-ms = <50>;
            key-positions = <5 6 7>;
            bindings = <&kp DEL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W  &kp E     &kp R  &kp T            &kp Y    &kp U            &kp I      &kp O    &kp P         
&mt LCTRL A  &kp S  &kp D     &kp F  &kp G            &kp H    &kp J            &kp K      &kp L    &kp SEMI      
&mt LSHFT Z  &kp X  &kp C     &kp V  &kp B            &kp N    &kp M            &kp COMMA  &kp DOT  &mt RSHFT FSLH
                    &kp LGUI  &mo 1  &kp SPACE    &kp RET  &lt 2 BACKSPACE  &kp RALT
            >;
        };

        lower_layer {
            bindings = <
&kp N1        &kp N2        &kp N3        &kp N4         &kp N5           &kp N6     &kp N7           &kp N8              &kp N9     &kp N0    
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4     &kp GRAVE  &kp LEFT         &kp UP              &kp RIGHT  &kp SQT  
&kp LSHFT     &none         &none         &studio_unlock &bt BT_CLR       &kp TILDE  &kp LEFT         &kp DOWN            &kp RIGHT  &kp RSHFT
                            &kp LGUI      &trans         &kp TAB          &kp RET    &lt 3 BACKSPACE  &kp RALT
            >;
        };

        raise_layer {
            bindings = <
&kp EXCL   &kp AT  &kp HASH  &kp DLLR  &kp PRCNT        &kp CARET  &kp AMPS   &kp ASTRK           &kp LPAR  &kp RPAR
&none      &none   &none     &none     &none            &kp MINUS  &kp EQUAL  &kp LBKT            &kp RBKT  &kp BSLH
&kp LSHFT  &none   &none     &none     &none            &kp UNDER  &kp PLUS   &kp LBRC            &kp RBRC  &kp PIPE
                   &kp LGUI  &mo 3     &kp SPACE        &kp RET    &trans     &kp RALT
            >;
        };

        func_layer {
            bindings = <
&kp F1         &kp F2         &kp F3         &kp F4         &kp F5            &kp F6   &kp F7  &kp F8              &kp F9   &kp F10
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4     &none    &none   &none               &kp F11  &kp F12 
&none          &none          &none          &bt BT_CLR     &bt BT_CLR_ALL    &none    &none   &kp LT              &kp GT   &none   
                              &kp LGUI       &trans         &kp TAB           &kp RET  &trans  &kp RALT
            >;
        };
    };
};
